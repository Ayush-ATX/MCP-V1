# MahaSamvaad Eval MCP Suite — Environment Configuration
# Copy this file to .env and fill in active keys/endpoints.

# --- Staging BG chat endpoint under evaluation ---
CHAT_API_BASE_URL=http://20.40.56.211:8000
CHAT_API_CHAT_PATH=/api/v1/chat
CHAT_API_CHAT_STREAM_PATH=/api/v1/chat/stream
CHAT_API_HEALTH_PATH=/health
MAHASAMVAAD_BASE_URL=http://20.40.56.211:8000

# --- Corpus PDF / document storage endpoint ---
STORAGE_API_BASE_URL=http://20.40.56.211/api/v1/storage

# --- Secondary inference endpoint ---
INFERENCE_BASE_URL=http://20.246.76.245:3001

# --- LLM-as-judge (NVIDIA-hosted) ---
LLM_JUDGE_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_JUDGE_API_KEY=your-nvidia-api-key-here
LLM_JUDGE_MODEL=moonshotai/kimi-k3

# --- Reformulation model ---
REFORMULATION_BASE_URL=https://integrate.api.nvidia.com/v1
REFORMULATION_API_KEY=your-nvidia-api-key-here
REFORMULATION_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# --- Embedding model for grounding v2 (embedding_v2) ---
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_API_KEY=your-nvidia-api-key-here
EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# --- Grounding method (embedding_v2 with fallback to difflib_v1) ---
GROUNDING_METHOD=embedding_v2
GROUNDING_THRESHOLD=0.55

# --- Web search (used by chat fusion and direct evaluation) ---
SERPER_API_KEY=4f451ce59ecc8fbad9f5f455501878723dccdc77

# --- Storage ---
SQLITE_DB_PATH=./storage/mahasamvaad_eval.db
STORE_DB_PATH=./storage/mahasamvaad_eval.db

# --- MCP Transport ---
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8001
MCP_DEFAULT_USER_ID=mcp-eval-bot
MCP_HTTP_TIMEOUT_S=60
LOG_LEVEL=INFO
