# MahaSamvaad MCP Server Suite — Environment Variables
# Copy this file to .env and fill in values before running.
# All variables have sane defaults; override only what you need.

# ── Staging endpoint ──────────────────────────────────────────────────────────
MAHASAMVAAD_BASE_URL=http://20.40.56.211:8000

# ── Shared SQLite store ───────────────────────────────────────────────────────
STORE_DB_PATH=./data/store.db

# ── Default user identity ─────────────────────────────────────────────────────
MCP_DEFAULT_USER_ID=mcp-eval-bot

# ── HTTP timeout (seconds) ────────────────────────────────────────────────────
MCP_HTTP_TIMEOUT_S=60

# ── Grounding ─────────────────────────────────────────────────────────────────
GROUNDING_METHOD=difflib_v1          # difflib_v1 | embedding_v2 (stretch)
GROUNDING_THRESHOLD=0.55             # min match ratio to count a sentence as grounded

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR

# ── Server 3 — reformulation model ───────────────────────────────────────────
REFORMULATION_API_KEY=replace-with-your-api-key
REFORMULATION_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
REFORMULATION_BASE_URL=https://integrate.api.nvidia.com/v1

# ── MCP transport ────────────────────────────────────────────────────────────
MCP_TRANSPORT=stdio                  # stdio | streamable-http
MCP_HTTP_HOST=127.0.0.1              # bind address for streamable-http
MCP_HTTP_PORT=8001                   # port for streamable-http (use 8002/8003 for servers 2/3)
